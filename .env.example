# Supabase sync for the TOEIC 550 app.
# Copy these values from the Supabase Dashboard of the app's own project:
# Settings -> API -> Project URL and anon / public key.
# Set them as Environment Variables in Vercel (Production), never paste
# them into chat. Without them the app still works on localStorage only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
